# Copy to .env and fill in real values. Never commit .env.

# --- Database ---
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=looksmatter_dev

# --- Auth ---
# Long random string used to sign JWTs (tokens expire after 7 days).
JWT_SECRET=replace-with-a-long-random-secret

# --- Server ---
PORT=5000

# --- Development seed (npm run seed) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# --- Payment gateway (UPI) ---
PaymentGateway_CLIENT_ID=
PaymentGateway_SECRET_KEY=
PaymentGateway_ENCRYPTION_KEY=
PaymentGateway_API_URL=
PaymentGateway_STATUS_API_URL=
# Public URL the provider calls back, e.g. https://your-api.example.com/api/payment/webhook
PaymentGateway_CALLBACK_URL=
