# gateway — copy to .env. The gateway holds no secrets: it only routes requests.

# Public port. The storefront's VITE_API_BASE_URL points here (http://localhost:5000/api).
PORT=5000

# Where the services listen. Only the gateway needs to reach them.
CORE_SERVICE_URL=http://localhost:5001
ORDER_SERVICE_URL=http://localhost:5002

# Browser origins allowed to call the API (comma-separated). Leave empty for the
# defaults: localhost:5173, looksmatter.in, www.looksmatter.in, looksmatter.netlify.app
CORS_ORIGINS=

# How long to wait for a service before answering 504 (milliseconds).
PROXY_TIMEOUT_MS=30000
