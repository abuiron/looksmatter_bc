# core-service — copy to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=5001

# --- Database: users, products, carts, favorites, support reports ---
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=looksmatter

# --- Auth ---
# Long random string used to sign JWTs (tokens expire after 7 days).
# order-service verifies the same tokens, so it needs the SAME value.
JWT_SECRET=replace-with-a-long-random-secret

# --- Service-to-service ---
# Shared secret for /internal calls between services. Same value in order-service.
INTERNAL_API_KEY=replace-with-a-long-random-string
ORDER_SERVICE_URL=http://localhost:5002

# --- Development seed (npm run seed) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
# Optional: catalogue JSON to load. Defaults to src/data/products.json in the
# looksmatter_ui repo checked out next to looksmatter-backend.
SEED_PRODUCTS_FILE=

# Payment gateway settings moved to order-service: this service no longer handles payments.
