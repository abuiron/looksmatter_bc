# order-service — copy to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=5002

# --- Database: this service's own database ---
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=looksmatter_orders

# --- Auth ---
# Must be the SAME value as core-service: tokens are issued there and verified here.
JWT_SECRET=replace-with-the-same-secret-as-core-service

# --- Service-to-service ---
# Shared secret for /internal calls between services. Same value in core-service.
INTERNAL_API_KEY=replace-with-a-long-random-string
CORE_SERVICE_URL=http://localhost:5001

# --- Payment gateway (UPI): only this service holds these ---
PaymentGateway_CLIENT_ID=
PaymentGateway_SECRET_KEY=
PaymentGateway_ENCRYPTION_KEY=
PaymentGateway_API_URL=
PaymentGateway_STATUS_API_URL=
# Public webhook URL through the gateway, e.g. https://api.example.com/api/payment/webhook
PaymentGateway_CALLBACK_URL=

# --- One-time data migration only (npm run migrate) ---
# The monolith's database that still holds the old `orders` collection.
SOURCE_MONGO_DB=looksmatter
# Defaults to MONGO_URI when empty.
SOURCE_MONGO_URI=
